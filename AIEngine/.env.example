# CakapKarier AIEngine local configuration
# IMPORTANT: DO NOT commit your actual .env file to version control.
# Copy this file to .env and fill GENAI_API_KEY only if optional GenAI summaries are needed.

# Production/free-tier default: Gemini API via OpenAI-compatible Chat Completions.
GENAI_PROVIDER=gemini
GENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GENAI_MODEL=gemini-2.5-flash-lite
GENAI_TIMEOUT_SECONDS=8
GENAI_MAX_RETRIES=1

# Gemini requires a Google AI Studio API key. Never expose this key to frontend code.
GENAI_API_KEY=

# Optional local development fallback.
# GENAI_PROVIDER=ollama
# GENAI_API_URL=http://localhost:11434/v1/chat/completions
# GENAI_MODEL=llama3.1
# GENAI_API_KEY=

# Optional model path override.
# CAKAP_MODEL_DIR=AIEngine/models/registry/career-match/v1
