# CakapKarier AIEngine local configuration

# GenAI provider is Gemini via OpenAI-compatible endpoint.
GENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GENAI_MODEL=gemini-2.5-flash
GENAI_TIMEOUT_SECONDS=8
GENAI_TEMPERATURE=0.2
GENAI_MAX_TOKENS=180

# Required for Gemini API.
GENAI_API_KEY=

# Optional model path override.
# CAKAP_MODEL_DIR=AIEngine/models/registry/career-match/v1
