# ==============================================================
# IMPORTANT: DO NOT commit your actual .env file to version control.
# Copy this file to .env and replace the values with your own.
# ==============================================================

PORT=3000
NODE_ENV=development
TRUST_PROXY=false
API_DOCS_ENABLED=true
DEBUG_ERRORS=false
JSON_BODY_LIMIT=256kb

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
DB_NAME=cakapkarier_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# Security
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Password Reset Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=replace_with_smtp_app_password_if_reset_password_is_demoed
SMTP_FROM="CakapKarier AI <no-reply@your-verified-domain.com>"
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

# AIEngine Integration
AI_CAREER_MATCH_URL=http://127.0.0.1:8001
AI_REQUEST_TIMEOUT_MS=30000
